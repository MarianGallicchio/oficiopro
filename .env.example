# ===== OficioPro =====

# --- Firebase Authentication (login con Google, Facebook y email) ---
# 1) Creá un proyecto en https://console.firebase.google.com
# 2) Authentication → Sign-in method → habilitá Google, Facebook y Email/Password
# 3) Configuración del proyecto → Tus apps → Web → copiá estos valores:
#    authDomain = <tu-proyecto>.firebaseapp.com
VITE_FIREBASE_API_KEY="TU_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="TU_PROYECTO.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="TU_PROYECTO"

# --- Otras (placeholders originales) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
